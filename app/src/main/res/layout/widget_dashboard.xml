<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ITdeti" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/widget_text" />
            <TextView android:id="@+id/widget_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="11sp" android:textColor="@color/widget_muted" />
        </LinearLayout>
        <TextView android:id="@+id/widget_more" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Открыть  →" android:textSize="11sp" android:textColor="@color/widget_accent" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="10dp">
        <TextView android:id="@+id/widget_today" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10sp" android:textStyle="bold" android:background="@drawable/widget_tab" />
        <TextView android:id="@+id/widget_tomorrow" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10sp" android:background="@drawable/widget_tab" android:layout_marginStart="4dp" />
        <TextView android:id="@+id/widget_week" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10sp" android:background="@drawable/widget_tab" android:layout_marginStart="4dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_stats" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="9dp" android:orientation="horizontal" android:background="@drawable/widget_card" android:padding="7dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/widget_stat_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/widget_text" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="всего" android:textSize="8sp" android:textColor="@color/widget_muted" /></LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/widget_stat_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/widget_text" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="уроки" android:textSize="8sp" android:textColor="@color/widget_muted" /></LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/widget_stat_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/widget_text" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="события" android:textSize="8sp" android:textColor="@color/widget_muted" /></LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/widget_stat_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widget_accent" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="до следующего" android:textSize="8sp" android:textColor="@color/widget_muted" /></LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/widget_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="10sp" android:textColor="@color/widget_muted" />
    <TextView android:id="@+id/widget_event_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="5dp" android:padding="10dp" android:background="@drawable/widget_card" android:textSize="12sp" android:textColor="@color/widget_text" android:gravity="center_vertical" android:maxLines="2" />
    <TextView android:id="@+id/widget_event_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="5dp" android:padding="10dp" android:background="@drawable/widget_card" android:textSize="12sp" android:textColor="@color/widget_text" android:gravity="center_vertical" android:maxLines="2" />
    <TextView android:id="@+id/widget_event_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="5dp" android:padding="10dp" android:background="@drawable/widget_card" android:textSize="12sp" android:textColor="@color/widget_text" android:gravity="center_vertical" android:maxLines="2" />
    <TextView android:id="@+id/widget_event_4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="5dp" android:padding="10dp" android:background="@drawable/widget_card" android:textSize="12sp" android:textColor="@color/widget_text" android:gravity="center_vertical" android:maxLines="2" />
    <TextView android:id="@+id/widget_event_5" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="5dp" android:padding="10dp" android:background="@drawable/widget_card" android:textSize="12sp" android:textColor="@color/widget_text" android:gravity="center_vertical" android:maxLines="2" />
    <TextView android:id="@+id/widget_event_6" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="5dp" android:padding="10dp" android:background="@drawable/widget_card" android:textSize="12sp" android:textColor="@color/widget_text" android:gravity="center_vertical" android:maxLines="2" />
</LinearLayout>
