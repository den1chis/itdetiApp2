<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#F7F7F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ITdeti • Сегодня"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Расписание →"
            android:textSize="11sp"
            android:textColor="#555555"
            android:paddingStart="6dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_today"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Сегодня"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:background="#E4E4E4" />

        <TextView
            android:id="@+id/widget_tomorrow"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Завтра"
            android:textSize="11sp"
            android:textColor="#777777"
            android:background="#F0F0F0" />

        <TextView
            android:id="@+id/widget_week"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Неделя"
            android:textSize="11sp"
            android:textColor="#777777"
            android:background="#F0F0F0" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Ближайшее"
        android:textSize="12sp"
        android:textColor="#666666"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="3 уроков • 1 событий • 4 всего"
        android:textSize="11sp"
        android:textColor="#777777"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_event_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp"
        android:textSize="14sp"
        android:textColor="#222222"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_event_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:textSize="14sp"
        android:textColor="#222222"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_event_3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:textSize="14sp"
        android:textColor="#222222"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_event_4"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:textSize="14sp"
        android:textColor="#222222"
        android:maxLines="2"
        android:ellipsize="end"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_event_5"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:textSize="14sp"
        android:textColor="#222222"
        android:maxLines="2"
        android:ellipsize="end"
        android:visibility="gone" />

</LinearLayout>
