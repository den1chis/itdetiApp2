<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="54dp"
    android:layout_marginBottom="7dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_schedule_event_background"
    android:paddingStart="0dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/widget_schedule_event_color"
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:minHeight="38dp"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="10dp"
        android:background="#4F46E5"
        android:text="" />

    <LinearLayout
        android:id="@+id/widget_schedule_event_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="1dp"
        android:paddingBottom="1dp">

        <TextView
            android:id="@+id/widget_schedule_event_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#111827"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_schedule_event_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#374151"
            android:textSize="10sp"
            android:maxLines="2"
            android:ellipsize="end" />

    </LinearLayout>

</LinearLayout>